# Paths are relative to the backend working directory.
FUEL_DATA_DIR=./data
FUEL_CORS_ORIGINS=["http://localhost:5173"]
# Explicit Rosstat-only exception requested for this project; no global TLS bypass.
FUEL_ROSSTAT_VERIFY_TLS=false
FUEL_MIN_FREE_DISK_MB=2048
FUEL_ANOMALY_PERCENT=10
FUEL_RATE_LIMIT_PER_MINUTE=60
