[Unit]
Description=Fuel Monitor daily Rosstat collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fuelmon
Group=fuelmon
WorkingDirectory=/opt/fuel-monitor/backend
EnvironmentFile=/etc/fuel-monitor.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fuel-monitor/backend/.venv/bin/python -m app.cli collect --weeks 13
StateDirectory=fuel-monitor
LogsDirectory=fuel-monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=160M
CPUQuota=20%
Nice=10
TimeoutStartSec=16min
StandardOutput=append:/var/log/fuel-monitor/collector.log
StandardError=append:/var/log/fuel-monitor/collector.log
