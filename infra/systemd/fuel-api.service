[Unit]
Description=Fuel Monitor read-only API
After=network.target

[Service]
User=fuelmon
Group=fuelmon
WorkingDirectory=/opt/fuel-monitor/backend
EnvironmentFile=/etc/fuel-monitor.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fuel-monitor/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
StateDirectory=fuel-monitor
LogsDirectory=fuel-monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
CPUQuota=50%
StandardOutput=append:/var/log/fuel-monitor/api.log
StandardError=append:/var/log/fuel-monitor/api.log

[Install]
WantedBy=multi-user.target
